{
   "action": {
      "default_title": "__MSG_actionTitle__"
   },
   "background": {
      "service_worker": "background.js"
   },
   "commands": {
      "_execute_action": {
         "suggested_key": {
            "default": "Ctrl+Shift+K",
            "mac": "Command+Shift+K"
         }
      }
   },
   "content_scripts": [ {
      "all_frames": false,
      "js": [ "content-scripts/record.js", "content-scripts/selection.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_idle"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://*:* wss://*:* http://*:* https://*:* https://www.kimi.com https://www.kimi.ai https://gator.volces.com https://agent-gw.kimi.com;"
   },
   "default_locale": "en",
   "description": "__MSG_description__",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "icon/128.png",
      "16": "icon/16.png",
      "32": "icon/32.png",
      "48": "icon/48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Kimi",
   "options_ui": {
      "page": "options.html"
   },
   "permissions": [ "tabs", "activeTab", "debugger", "storage", "alarms", "tabGroups", "windows", "sidePanel", "contextMenus", "favicon", "webNavigation", "webRequest", "scripting", "unlimitedStorage" ],
   "side_panel": {
      "default_path": "sidepanel.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.0.23"
}
